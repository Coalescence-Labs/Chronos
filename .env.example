# WorkOS AuthKit (COA-200) — copy to .env.local; never commit secrets.
# Dashboard: https://dashboard.workos.com
#
# Auth is OPTIONAL. With these unset, Chronos still runs (anonymous public paste).
# Do not set a partial WorkOS config — either all required vars below, or none.
#
# Redirects to configure in WorkOS:
# - Redirect URI:        NEXT_PUBLIC_WORKOS_REDIRECT_URI  ← AuthKit reads THIS name only
# - Sign-in endpoint:    http://localhost:3005/sign-in
# - Sign-up (optional):  http://localhost:3005/sign-up
# Logout never uses NEXT_PUBLIC_SITE_URL (SEO-only; defaults to production).
# Chronos clears the session cookie locally and returns to the *request* origin
# (Host / window.location.origin) — not WorkOS hosted logout.
# - Logout redirect URI (optional — only if you switch back to AuthKit signOut()):
#     http://localhost:3005/
#     https://chronos.coalescencelabs.app/   (production)

#
# Note: there is no WORKOS_REDIRECT_URI env var in AuthKit Next.js — the package
# maps process.env.NEXT_PUBLIC_WORKOS_REDIRECT_URI → internal WORKOS_REDIRECT_URI.

WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=sk_test_...
# ≥32 characters — e.g. `openssl rand -base64 24`
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3005/callback

# Prefer a short sealed-session TTL (AuthKit default is 400 days).
# 7 days aligns with Chronos "minimum time" session posture.
WORKOS_COOKIE_MAX_AGE=604800
WORKOS_COOKIE_SAMESITE=lax
# WORKOS_COOKIE_NAME=wos-session

# Enable in the WorkOS dashboard Authentication settings (no app code change):
# - Email + password
# - GitHub social connection (login identity — distinct from GitHub repo OAuth / COA-202)
# - Google social connection
# - MFA (TOTP) required or optional
# - Passkeys (WebAuthn) — see docs/AUTH.md


# GitHub repo OAuth (COA-202) — distinct from WorkOS "Sign in with GitHub".
# Create an OAuth App: https://github.com/settings/developers
# Authorization callback URL must match GITHUB_OAUTH_CALLBACK_URL (or
# {origin}/api/github/callback when unset).
# Optional: omit all of these to run without Connect GitHub.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# ≥32 characters — e.g. `openssl rand -base64 24` (can reuse WORKOS_COOKIE_PASSWORD)
GITHUB_SESSION_PASSWORD=
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:3005/api/github/callback
# Optional shared app token for anonymous public paste rate limits:
# GITHUB_TOKEN=
